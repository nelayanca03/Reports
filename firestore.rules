rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 5
        && request.auth.token.email.size() <= 120;
    }

    function emailDocId() {
      return request.auth.token.email
        .lower()
        .replace('[@]', '_at_')
        .replace('[.]', '_dot_')
        .replace('[^a-z0-9_\\-]', '_');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'nelayanca03@gmail.com';
    }

    function hasActiveAccount() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/accounts/$(emailDocId()))
        && get(/databases/$(database)/documents/accounts/$(emailDocId())).data.active == true;
    }

    function currentAccountRole() {
      return get(/databases/$(database)/documents/accounts/$(emailDocId())).data.role;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (hasActiveAccount() && currentAccountRole() == 'admin');
    }

    function isOperationalRole(roleId) {
      return roleId in ['stock_accounting', 'gl', 'accounting'];
    }

    function isAccountRole(role) {
      return role in ['admin', 'stock_accounting', 'gl', 'accounting'];
    }

    function hasRoleAccess(roleId) {
      return isAdmin() || (hasActiveAccount() && currentAccountRole() == roleId);
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'picName', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && data.keys().hasOnly(['email', 'name', 'role', 'picName', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role is string && isAccountRole(data.role)
        && data.picName is string && data.picName.size() <= 60
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidAdminDirectory(data) {
      return data.keys().hasAll(['accounts', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['accounts', 'updatedAt', 'updatedBy'])
        && data.accounts is map && data.accounts.size() <= 200
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidRoleConfig(data) {
      return data.keys().hasAll(['roleId', 'label', 'start', 'ndays', 'tasks', 'outlets', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'label', 'start', 'ndays', 'openUntilMonth', 'unlockedPastMonths', 'tasks', 'outlets', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 60
        && data.start is string && data.start.size() == 10 && data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.ndays is int && data.ndays >= 1 && data.ndays <= 60
        && (!('openUntilMonth' in data) || isValidMonthKey(data.openUntilMonth))
        && (!('unlockedPastMonths' in data) || (
          data.unlockedPastMonths is list
          && data.unlockedPastMonths.size() <= 24
          && (data.unlockedPastMonths.size() == 0 || isValidMonthKey(data.unlockedPastMonths[0]))
        ))
        && data.tasks is list && data.tasks.size() <= 30
        && (data.tasks.size() == 0 || (
          data.tasks[0] is map
          && data.tasks[0].key is string && data.tasks[0].key.size() >= 1 && data.tasks[0].key.size() <= 40
          && data.tasks[0].label is string && data.tasks[0].label.size() >= 1 && data.tasks[0].label.size() <= 100
        ))
        && data.outlets is list && data.outlets.size() <= 100
        && (data.outlets.size() == 0 || (
          data.outlets[0] is map
          && data.outlets[0].code is string && data.outlets[0].code.size() >= 1 && data.outlets[0].code.size() <= 40
          && data.outlets[0].person is string && data.outlets[0].person.size() >= 1 && data.outlets[0].person.size() <= 60
        ))
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidRoleWorkspace(data) {
      return data.keys().hasAll(['roleId', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.ent is map && data.ent.size() <= 100
        && data.visit is map && data.visit.size() <= 1000
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidMonthKey(monthKey) {
      return monthKey is string && monthKey.size() == 7 && monthKey.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidMonthDocId(docId) {
      return docId is string
        && docId.size() >= 10
        && docId.size() <= 40
        && docId.matches('^(stock_accounting|gl|accounting)_[0-9]{4}-[0-9]{2}$');
    }

    function roleFromMonthDocId(docId) {
      return docId.matches('^stock_accounting_.*')
        ? 'stock_accounting'
        : (docId.matches('^gl_.*') ? 'gl' : 'accounting');
    }

    function isValidRoleMonthlyWorkspace(data) {
      return data.keys().hasAll(['roleId', 'monthKey', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'monthKey', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && isValidMonthKey(data.monthKey)
        && data.ent is map && data.ent.size() <= 100
        && data.visit is map && data.visit.size() <= 1000
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function currentWibMonthKey() {
      return string((request.time + duration.time(7, 0, 0, 0)).year())
        + '-'
        + ((request.time + duration.time(7, 0, 0, 0)).month() < 10
          ? '0' + string((request.time + duration.time(7, 0, 0, 0)).month())
          : string((request.time + duration.time(7, 0, 0, 0)).month()));
    }

    function isMonthUnlockedForRole(roleId, monthKey) {
      return exists(/databases/$(database)/documents/roleConfigs/$(roleId))
        && 'unlockedPastMonths' in get(/databases/$(database)/documents/roleConfigs/$(roleId)).data
        && get(/databases/$(database)/documents/roleConfigs/$(roleId)).data.unlockedPastMonths is list
        && monthKey in get(/databases/$(database)/documents/roleConfigs/$(roleId)).data.unlockedPastMonths;
    }

    function canWriteMonth(roleId, monthKey) {
      return isAdmin() || monthKey >= currentWibMonthKey() || isMonthUnlockedForRole(roleId, monthKey);
    }

    function isValidInputLog(data) {
      return data.keys().hasAll([
          'uid', 'userEmail', 'userName', 'userRole', 'roleId', 'roleLabel',
          'actionType', 'pic', 'outlet', 'day', 'details', 'itemCount',
          'clientTs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'userEmail', 'userName', 'userRole', 'roleId', 'roleLabel',
          'actionType', 'pic', 'outlet', 'day', 'details', 'itemCount',
          'clientTs', 'createdAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.userEmail is string && data.userEmail.size() >= 5 && data.userEmail.size() <= 120
        && data.userEmail == request.auth.token.email.lower()
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.userRole is string && isAccountRole(data.userRole)
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.roleLabel is string && data.roleLabel.size() >= 2 && data.roleLabel.size() <= 60
        && data.actionType is string && data.actionType in ['input_harian', 'kunjungan']
        && data.pic is string && data.pic.size() <= 60
        && data.outlet is string && data.outlet.size() <= 120
        && data.day is string && data.day.size() == 10 && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.details is string && data.details.size() <= 600
        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 50
        && data.clientTs is string && data.clientTs.size() >= 10 && data.clientTs.size() <= 40
        && data.createdAt is timestamp;
    }

    match /accounts/{accountId} {
      allow get: if isVerifiedUser() && isValidId(accountId) && (
        existing().email == request.auth.token.email.lower() || isAdmin()
      );
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && isAdmin()
        && (incoming().role != 'admin' || isBootstrappedAdmin())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && isAdmin()
        && ((incoming().role != 'admin' && existing().role != 'admin') || isBootstrappedAdmin())
        && (existing().email != 'nelayanca03@gmail.com' || (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().active == true))
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'picName', 'active', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(accountId)
        && isAdmin()
        && existing().email != 'nelayanca03@gmail.com'
        && (existing().role != 'admin' || isBootstrappedAdmin());
    }

    match /adminRegistry/{registryId} {
      allow get: if isVerifiedUser() && isValidId(registryId) && registryId == 'accounts' && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(registryId)
        && registryId == 'accounts'
        && isValidAdminDirectory(incoming())
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(registryId)
        && registryId == 'accounts'
        && isValidAdminDirectory(incoming())
        && isAdmin()
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['accounts', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /roleConfigs/{roleId} {
      allow get: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && hasRoleAccess(roleId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleConfig(incoming())
        && isAdmin()
        && incoming().roleId == roleId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleConfig(incoming())
        && isAdmin()
        && incoming().roleId == existing().roleId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'start', 'ndays', 'openUntilMonth', 'unlockedPastMonths', 'tasks', 'outlets', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /roleWorkspaces/{roleId} {
      allow get: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && hasRoleAccess(roleId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleWorkspace(incoming())
        && hasRoleAccess(roleId)
        && incoming().roleId == roleId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleWorkspace(incoming())
        && hasRoleAccess(roleId)
        && incoming().roleId == existing().roleId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ent', 'visit', 'updatedAt', 'updatedBy']);
      allow delete: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && isAdmin();
    }

    match /roleMonthlyWorkspaces/{workspaceMonthId} {
      allow get: if isVerifiedUser() && isValidMonthDocId(workspaceMonthId) && hasRoleAccess(roleFromMonthDocId(workspaceMonthId));
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidMonthDocId(workspaceMonthId)
        && isValidRoleMonthlyWorkspace(incoming())
        && hasRoleAccess(incoming().roleId)
        && canWriteMonth(incoming().roleId, incoming().monthKey)
        && workspaceMonthId == (incoming().roleId + '_' + incoming().monthKey)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidMonthDocId(workspaceMonthId)
        && isValidRoleMonthlyWorkspace(incoming())
        && hasRoleAccess(existing().roleId)
        && canWriteMonth(existing().roleId, existing().monthKey)
        && incoming().roleId == existing().roleId
        && incoming().monthKey == existing().monthKey
        && workspaceMonthId == (existing().roleId + '_' + existing().monthKey)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ent', 'visit', 'updatedAt', 'updatedBy']);
      allow delete: if isVerifiedUser() && isValidMonthDocId(workspaceMonthId) && hasRoleAccess(roleFromMonthDocId(workspaceMonthId)) && isAdmin();
    }

    match /inputLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidInputLog(incoming())
        && hasRoleAccess(incoming().roleId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
