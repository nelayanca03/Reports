rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 5
        && request.auth.token.email.size() <= 120;
    }

    function emailDocId() {
      return request.auth.token.email
        .lower()
        .replace('[@]', '_at_')
        .replace('[.]', '_dot_')
        .replace('[^a-z0-9_\\-]', '_');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'nelayanca03@gmail.com';
    }

    function accountDocPath() {
      return /databases/$(database)/documents/accounts/$(emailDocId());
    }

    function hasActiveAccount() {
      let path = accountDocPath();
      return isVerifiedUser()
        && exists(path)
        && get(path).data.active == true;
    }

    function currentAccountRole() {
      return get(accountDocPath()).data.role;
    }

    function isAdmin() {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(path)
        && get(path).data.active == true
        && get(path).data.role == 'admin'
      );
    }

    function isOperationalRole(roleId) {
      return roleId in ['stock_accounting', 'gl', 'accounting'];
    }

    function isAccountRole(role) {
      return role in ['admin', 'stock_accounting', 'gl', 'accounting'];
    }

    function hasRoleAccess(roleId) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(path)
        && get(path).data.active == true
        && (get(path).data.role == 'admin' || get(path).data.role == roleId)
      );
    }

    function isAccountingOrAdmin() {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(path)
        && get(path).data.active == true
        && get(path).data.role in ['admin', 'accounting']
      );
    }

    function accountPicFromData(acc) {
      return ('picName' in acc && acc.picName is string && acc.picName.trim().size() > 0)
        ? acc.picName.trim().upper()
        : (('name' in acc && acc.name is string) ? acc.name.trim().upper() : '');
    }

    function isAuthorizedRecordPrefixForAcc(prefix, acc) {
      return prefix in ['SA', 'GL']
        && acc.active == true
        && (
          acc.role == 'admin'
          || (
            acc.role == 'accounting'
            && (
              ('refPrefix' in acc && acc.refPrefix in ['SA', 'GL'])
                ? prefix == acc.refPrefix
                : prefix == 'SA'
            )
          )
          || (acc.role == 'stock_accounting' && prefix == 'SA')
          || (acc.role == 'gl' && prefix == 'GL')
        );
    }

    function isAuthorizedRecordPrefix(prefix) {
      let path = accountDocPath();
      return (prefix in ['SA', 'GL']) && (
        isBootstrappedAdmin() || (
          isVerifiedUser()
          && exists(path)
          && isAuthorizedRecordPrefixForAcc(prefix, get(path).data)
        )
      );
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'picName', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && data.keys().hasOnly(['email', 'name', 'role', 'picName', 'refPrefix', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role is string && isAccountRole(data.role)
        && data.picName is string && data.picName.size() <= 60
        && (!('refPrefix' in data) || (data.refPrefix is string && data.refPrefix in ['SA', 'GL']))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidAdminDirectory(data) {
      return data.keys().hasAll(['accounts', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['accounts', 'updatedAt', 'updatedBy'])
        && data.accounts is map && data.accounts.size() <= 200
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidAdminResetSecurity(data) {
      return data.keys().hasAll(['passwordHash', 'salt', 'iterations', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['passwordHash', 'salt', 'iterations', 'updatedAt', 'updatedBy'])
        && data.passwordHash is string && data.passwordHash.size() == 64 && data.passwordHash.matches('^[0-9a-f]{64}$')
        && data.salt is string && data.salt.size() == 32 && data.salt.matches('^[0-9a-f]{32}$')
        && data.iterations is int && data.iterations == 100000
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidRoleConfig(data) {
      return data.keys().hasAll(['roleId', 'label', 'start', 'ndays', 'tasks', 'outlets', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'label', 'start', 'ndays', 'openUntilMonth', 'unlockedPastMonths', 'tasks', 'outlets', 'outletsByPic', 'dayAdjustments', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 60
        && data.start is string && data.start.size() == 10 && data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.ndays is int && data.ndays >= 1 && data.ndays <= 60
        && (!('openUntilMonth' in data) || isValidMonthKey(data.openUntilMonth))
        && (!('unlockedPastMonths' in data) || (
          data.unlockedPastMonths is list
          && data.unlockedPastMonths.size() <= 24
          && (data.unlockedPastMonths.size() == 0 || isValidMonthKey(data.unlockedPastMonths[0]))
        ))
        && (!('outletsByPic' in data) || (
          data.outletsByPic is map
          && data.outletsByPic.size() <= 100
        ))
        && (!('dayAdjustments' in data) || (
          data.dayAdjustments is list
          && data.dayAdjustments.size() <= 200
          && (data.dayAdjustments.size() == 0 || (
            data.dayAdjustments[0] is map
            && data.dayAdjustments[0].id is string && data.dayAdjustments[0].id.size() >= 1 && data.dayAdjustments[0].id.size() <= 64
            && data.dayAdjustments[0].type is string && data.dayAdjustments[0].type in ['off_day', 'cuti_izin', 'cuti_bersama', 'libur_nasional']
            && data.dayAdjustments[0].scope is string && data.dayAdjustments[0].scope in ['person', 'role', 'all']
            && data.dayAdjustments[0].dateFrom is string && data.dayAdjustments[0].dateFrom.size() == 10 && data.dayAdjustments[0].dateFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.dayAdjustments[0].dateTo is string && data.dayAdjustments[0].dateTo.size() == 10 && data.dayAdjustments[0].dateTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          ))
        ))
        && data.tasks is list && data.tasks.size() <= 30
        && (data.tasks.size() == 0 || (
          data.tasks[0] is map
          && data.tasks[0].key is string && data.tasks[0].key.size() >= 1 && data.tasks[0].key.size() <= 40
          && data.tasks[0].label is string && data.tasks[0].label.size() >= 1 && data.tasks[0].label.size() <= 100
        ))
        && data.outlets is list && data.outlets.size() <= 100
        && (data.outlets.size() == 0 || (
          data.outlets[0] is map
          && data.outlets[0].code is string && data.outlets[0].code.size() >= 1 && data.outlets[0].code.size() <= 40
          && data.outlets[0].person is string && data.outlets[0].person.size() >= 1 && data.outlets[0].person.size() <= 60
        ))
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidRoleWorkspace(data) {
      return data.keys().hasAll(['roleId', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.ent is map && data.ent.size() <= 100
        && data.visit is map && data.visit.size() <= 1000
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function isValidMonthKey(monthKey) {
      return monthKey is string && monthKey.size() == 7 && monthKey.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidMonthDocId(docId) {
      return docId is string
        && docId.size() >= 10
        && docId.size() <= 40
        && docId.matches('^(stock_accounting|gl|accounting)_[0-9]{4}-[0-9]{2}$');
    }

    function roleFromMonthDocId(docId) {
      return docId.matches('^stock_accounting_.*')
        ? 'stock_accounting'
        : (docId.matches('^gl_.*') ? 'gl' : 'accounting');
    }

    function isValidRoleMonthlyWorkspace(data) {
      return data.keys().hasAll(['roleId', 'monthKey', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleId', 'monthKey', 'ent', 'visit', 'updatedAt', 'updatedBy'])
        && data.roleId is string && isOperationalRole(data.roleId)
        && isValidMonthKey(data.monthKey)
        && data.ent is map && data.ent.size() <= 100
        && data.visit is map && data.visit.size() <= 1000
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function dateKeyFromShiftedTs(ts) {
      return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day());
    }

    function currentWibDateKey() {
      return dateKeyFromShiftedTs(request.time + duration.value(7, 'h'));
    }

    function currentWibMonthKey() {
      return currentWibDateKey()[0:7];
    }

    function yesterdayWibDateKey() {
      return dateKeyFromShiftedTs(request.time - duration.value(17, 'h'));
    }

    function tomorrowWibDateKey() {
      return dateKeyFromShiftedTs(request.time + duration.value(31, 'h'));
    }

    function isMonthUnlockedInCfg(cfg, monthKey) {
      return 'unlockedPastMonths' in cfg
        && cfg.unlockedPastMonths is list
        && monthKey in cfg.unlockedPastMonths;
    }

    function isMonthUnlockedForRole(roleId, monthKey) {
      let cfgPath = /databases/$(database)/documents/roleConfigs/$(roleId);
      return exists(cfgPath) && isMonthUnlockedInCfg(get(cfgPath).data, monthKey);
    }

    function roleOutletsFromCfg(cfg, picUpper) {
      return ('outletsByPic' in cfg
        && cfg.outletsByPic is map
        && picUpper in cfg.outletsByPic
        && cfg.outletsByPic[picUpper] is list)
        ? cfg.outletsByPic[picUpper]
        : [];
    }

    function roleOutletsForPic(roleId, picUpper) {
      let cfgPath = /databases/$(database)/documents/roleConfigs/$(roleId);
      return picUpper != '' && exists(cfgPath)
        ? roleOutletsFromCfg(get(cfgPath).data, picUpper)
        : [];
    }

    function canAccountWriteWorkspace(acc, roleId, checkMonth, monthKey, changedOutlets, changedVisitKeys) {
      let isAdm = acc.active == true && acc.role == 'admin';
      let hasRole = acc.active == true && (isAdm || acc.role == roleId);
      let picUpper = acc.active == true ? accountPicFromData(acc) : '';
      return hasRole && (
        isAdm || (
          (!checkMonth || monthKey >= currentWibMonthKey() || isMonthUnlockedForRole(roleId, monthKey))
          && (changedOutlets.size() == 0 || (picUpper != '' && changedOutlets.hasOnly(roleOutletsForPic(roleId, picUpper))))
          && (changedVisitKeys.size() == 0 || (
            picUpper != ''
            && changedVisitKeys.hasOnly([
              picUpper + '|' + yesterdayWibDateKey(),
              picUpper + '|' + currentWibDateKey(),
              picUpper + '|' + tomorrowWibDateKey()
            ])
          ))
        )
      );
    }

    function canWriteWorkspace(roleId, changedOutlets, changedVisitKeys) {
      let accPath = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(accPath)
        && canAccountWriteWorkspace(get(accPath).data, roleId, false, '', changedOutlets, changedVisitKeys)
      );
    }

    function canWriteMonthlyWorkspace(roleId, monthKey, changedOutlets, changedVisitKeys) {
      let accPath = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(accPath)
        && canAccountWriteWorkspace(get(accPath).data, roleId, true, monthKey, changedOutlets, changedVisitKeys)
      );
    }

    function canAccountCreateInputLog(acc, roleId, pic) {
      let isAdm = acc.active == true && acc.role == 'admin';
      let picUpper = acc.active == true ? accountPicFromData(acc) : '';
      return acc.active == true && (
        isAdm || (
          acc.role == roleId
          && picUpper != ''
          && pic is string
          && pic.trim().upper() == picUpper
        )
      );
    }

    function canCreateInputLogAuth(roleId, pic) {
      let accPath = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(accPath)
        && canAccountCreateInputLog(get(accPath).data, roleId, pic)
      );
    }

    function canWriteSavedRecordAsAccount(acc, department, pic, outlet) {
      let picUpper = accountPicFromData(acc);
      return acc.active == true && (
        acc.role in ['admin', 'accounting']
        || (
          acc.role in ['stock_accounting', 'gl']
          && department == acc.role
          && picUpper != ''
          && pic is string
          && pic.trim().upper() == picUpper
          && outlet in roleOutletsForPic(acc.role, picUpper)
        )
      );
    }

    function canCreateSavedRecordAuth(prefix, department, pic, outlet) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(path)
        && isAuthorizedRecordPrefixForAcc(prefix, get(path).data)
        && canWriteSavedRecordAsAccount(get(path).data, department, pic, outlet)
      );
    }

    function canUpdateSavedRecordAuth(existingCreatedBy, prefix, department, pic, outlet) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(path)
        && canAccountUpdateSavedRecord(get(path).data, existingCreatedBy, prefix, department, pic, outlet)
      );
    }

    function canAccountUpdateSavedRecord(acc, existingCreatedBy, prefix, department, pic, outlet) {
      return acc.active == true && (
        acc.role in ['admin', 'accounting']
        || (
          existingCreatedBy == request.auth.uid
          && isAuthorizedRecordPrefixForAcc(prefix, acc)
          && canWriteSavedRecordAsAccount(acc, department, pic, outlet)
        )
      );
    }

    function isValidInputLog(data) {
      return data.keys().hasAll([
          'uid', 'userEmail', 'userName', 'userRole', 'roleId', 'roleLabel',
          'actionType', 'pic', 'outlet', 'day', 'details', 'itemCount',
          'clientTs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'userEmail', 'userName', 'userRole', 'roleId', 'roleLabel',
          'actionType', 'pic', 'outlet', 'day', 'details', 'itemCount',
          'clientTs', 'createdAt',
          'taskKey', 'prevDate', 'newDate', 'prevNote', 'newNote', 'action'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.userEmail is string && data.userEmail.size() >= 5 && data.userEmail.size() <= 120
        && data.userEmail == request.auth.token.email.lower()
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.userRole is string && isAccountRole(data.userRole)
        && data.roleId is string && isOperationalRole(data.roleId)
        && data.roleLabel is string && data.roleLabel.size() >= 2 && data.roleLabel.size() <= 60
        && data.actionType is string && data.actionType in ['input_harian', 'kunjungan']
        && data.pic is string && data.pic.size() <= 60
        && data.outlet is string && data.outlet.size() <= 120
        && data.day is string && data.day.size() == 10 && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.details is string && data.details.size() <= 600
        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 50
        && data.clientTs is string && data.clientTs.size() >= 10 && data.clientTs.size() <= 40
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['taskKey']) || (data.taskKey is string && data.taskKey.size() <= 40))
        && (!data.keys().hasAny(['prevDate']) || (data.prevDate is string && data.prevDate.size() <= 20))
        && (!data.keys().hasAny(['newDate']) || (data.newDate is string && data.newDate.size() <= 20))
        && (!data.keys().hasAny(['prevNote']) || (data.prevNote is string && data.prevNote.size() <= 100))
        && (!data.keys().hasAny(['newNote']) || (data.newNote is string && data.newNote.size() <= 100))
        && (!data.keys().hasAny(['action']) || (data.action is string && data.action in ['set', 'clear', 'edit']));
    }

    match /accounts/{accountId} {
      allow get: if isVerifiedUser() && isValidId(accountId) && (
        existing().email == request.auth.token.email.lower() || isAdmin()
      );
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && isAdmin()
        && (incoming().role != 'admin' || isBootstrappedAdmin())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && isAdmin()
        && ((incoming().role != 'admin' && existing().role != 'admin') || isBootstrappedAdmin())
        && (existing().email != 'nelayanca03@gmail.com' || (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().active == true))
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'picName', 'refPrefix', 'active', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(accountId)
        && isAdmin()
        && existing().email != 'nelayanca03@gmail.com'
        && (existing().role != 'admin' || isBootstrappedAdmin());
    }

    match /adminRegistry/{registryId} {
      allow get: if isVerifiedUser()
        && isValidId(registryId)
        && (registryId == 'accounts' || registryId == 'resetSecurity')
        && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(registryId)
        && (
          (registryId == 'accounts' && isValidAdminDirectory(incoming()))
          || (registryId == 'resetSecurity' && isValidAdminResetSecurity(incoming()))
        )
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(registryId)
        && (
          (
            registryId == 'accounts'
            && isValidAdminDirectory(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['accounts', 'updatedAt', 'updatedBy'])
          )
          || (
            registryId == 'resetSecurity'
            && isValidAdminResetSecurity(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'salt', 'iterations', 'updatedAt', 'updatedBy'])
          )
        )
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /roleConfigs/{roleId} {
      allow get: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && hasActiveAccount();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleConfig(incoming())
        && isAdmin()
        && incoming().roleId == roleId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleConfig(incoming())
        && isAdmin()
        && incoming().roleId == existing().roleId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'start', 'ndays', 'openUntilMonth', 'unlockedPastMonths', 'tasks', 'outlets', 'outletsByPic', 'dayAdjustments', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /roleWorkspaces/{roleId} {
      allow get: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && hasRoleAccess(roleId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleWorkspace(incoming())
        && canWriteWorkspace(incoming().roleId, incoming().ent.keys(), incoming().visit.keys())
        && incoming().roleId == roleId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(roleId)
        && isOperationalRole(roleId)
        && isValidRoleWorkspace(incoming())
        && canWriteWorkspace(existing().roleId, incoming().ent.diff(existing().ent).affectedKeys(), incoming().visit.diff(existing().visit).affectedKeys())
        && incoming().roleId == existing().roleId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ent', 'visit', 'updatedAt', 'updatedBy']);
      allow delete: if isVerifiedUser() && isValidId(roleId) && isOperationalRole(roleId) && isAdmin();
    }

    match /roleMonthlyWorkspaces/{workspaceMonthId} {
      allow get: if isVerifiedUser() && isValidMonthDocId(workspaceMonthId) && hasRoleAccess(roleFromMonthDocId(workspaceMonthId));
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidMonthDocId(workspaceMonthId)
        && isValidRoleMonthlyWorkspace(incoming())
        && canWriteMonthlyWorkspace(incoming().roleId, incoming().monthKey, incoming().ent.keys(), incoming().visit.keys())
        && workspaceMonthId == (incoming().roleId + '_' + incoming().monthKey)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidMonthDocId(workspaceMonthId)
        && isValidRoleMonthlyWorkspace(incoming())
        && canWriteMonthlyWorkspace(existing().roleId, existing().monthKey, incoming().ent.diff(existing().ent).affectedKeys(), incoming().visit.diff(existing().visit).affectedKeys())
        && incoming().roleId == existing().roleId
        && incoming().monthKey == existing().monthKey
        && workspaceMonthId == (existing().roleId + '_' + existing().monthKey)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ent', 'visit', 'updatedAt', 'updatedBy']);
      allow delete: if isVerifiedUser() && isValidMonthDocId(workspaceMonthId) && hasRoleAccess(roleFromMonthDocId(workspaceMonthId)) && isAdmin();
    }

    match /inputLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidInputLog(incoming())
        && canCreateInputLogAuth(incoming().roleId, incoming().pic)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }

    function isValidCalendarStartTime(t) {
      return t is string
        && t.size() == 5
        && t.matches('^((0[89]|1[0-8]):(00|30)|19:00)$');
    }

    function isValidVisibleToList(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 3
        && arr[0] is string && isOperationalRole(arr[0])
        && (arr.size() < 2 || (arr[1] is string && isOperationalRole(arr[1])))
        && (arr.size() < 3 || (arr[2] is string && isOperationalRole(arr[2])));
    }

    function isValidCalendarReturnTime(t) {
      return t is string
        && (t == '' || (t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }

    function isValidPicResponseEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['status', 'returnTime', 'cancelReason'])
        && entry.keys().hasOnly(['status', 'returnTime', 'cancelReason'])
        && entry.status is string && entry.status in ['assigned', 'completed', 'cancelled']
        && isValidCalendarReturnTime(entry.returnTime)
        && entry.cancelReason is string && entry.cancelReason.size() <= 200;
    }

    function isValidDismissedByAppend(prevData, nextData) {
      let prevList = ('dismissedBy' in prevData && prevData.dismissedBy is list) ? prevData.dismissedBy : [];
      return 'dismissedBy' in nextData
        && nextData.dismissedBy is list
        && nextData.dismissedBy.size() <= 100
        && request.auth.uid in nextData.dismissedBy
        && nextData.dismissedBy.hasAll(prevList)
        && nextData.dismissedBy.size() <= prevList.size() + 1;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll([
          'title', 'date', 'startTime', 'visibleTo', 'notes',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && data.keys().hasOnly([
          'title', 'date', 'startTime', 'visibleTo', 'notes',
          'eventType', 'assignScope', 'assignedDivision',
          'assignedPic', 'assignedPicUpper', 'assignedEmail',
          'assignedRole', 'assignedOutlet', 'assignStatus', 'returnTime',
          'cancelReason', 'notificationDismissed', 'dismissedBy', 'picResponses',
          'repeatFreq', 'repeatInterval', 'repeatUntil', 'repeatWeekdays', 'excludedDates',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidCalendarStartTime(data.startTime)
        && isValidVisibleToList(data.visibleTo)
        && data.notes is string && data.notes.size() <= 500
        && (!('eventType' in data) || (data.eventType is string && data.eventType in ['assign', 'general']))
        && (!('assignScope' in data) || (data.assignScope is string && data.assignScope in ['pic', 'division']))
        && (!('assignedDivision' in data) || (data.assignedDivision is string && (data.assignedDivision == '' || isOperationalRole(data.assignedDivision))))
        && (!('assignedPic' in data) || (data.assignedPic is string && data.assignedPic.size() <= 60))
        && (!('assignedPicUpper' in data) || (data.assignedPicUpper is string && data.assignedPicUpper.size() <= 60))
        && (!('assignedEmail' in data) || (data.assignedEmail is string && data.assignedEmail.size() <= 120))
        && (!('assignedRole' in data) || (data.assignedRole is string && isOperationalRole(data.assignedRole)))
        && (!('assignedOutlet' in data) || (data.assignedOutlet is string && data.assignedOutlet.size() <= 40))
        && (!('assignStatus' in data) || (data.assignStatus is string && data.assignStatus in ['assigned', 'completed', 'cancelled']))
        && (!('returnTime' in data) || isValidCalendarReturnTime(data.returnTime))
        && (!('cancelReason' in data) || (data.cancelReason is string && data.cancelReason.size() <= 200))
        && (!('notificationDismissed' in data) || data.notificationDismissed is bool)
        && (!('dismissedBy' in data) || (data.dismissedBy is list && data.dismissedBy.size() <= 100))
        && (!('picResponses' in data) || (data.picResponses is map && data.picResponses.size() <= 60))
        // PIC-scoped assign invariants
        && (
          !('eventType' in data) || data.eventType != 'assign'
          || ('assignScope' in data && data.assignScope == 'division')
          || (
            'assignedPic' in data && data.assignedPic.size() >= 1
            && 'assignedPicUpper' in data && data.assignedPicUpper.size() >= 1
            && data.assignedPicUpper == data.assignedPic.trim().upper()
            && 'assignedRole' in data && isOperationalRole(data.assignedRole)
            && (!('assignedDivision' in data) || data.assignedDivision == '')
            && 'assignStatus' in data && data.assignStatus in ['assigned', 'completed', 'cancelled']
            && 'notificationDismissed' in data && data.notificationDismissed is bool
          )
        )
        // Division-scoped assign invariants
        && (
          !('eventType' in data) || data.eventType != 'assign'
          || !('assignScope' in data) || data.assignScope != 'division'
          || (
            'assignedDivision' in data && isOperationalRole(data.assignedDivision)
            && 'assignedRole' in data && data.assignedRole == data.assignedDivision
            && (!('assignedPicUpper' in data) || data.assignedPicUpper == '')
            && (!('assignedEmail' in data) || data.assignedEmail == '')
            && 'assignStatus' in data && data.assignStatus in ['assigned', 'completed', 'cancelled']
          )
        )
        // Non-assign docs cannot populate query partition keys
        && (
          ('eventType' in data && data.eventType == 'assign')
          || (
            (!('assignedPicUpper' in data) || data.assignedPicUpper == '')
            && (!('assignedEmail' in data) || data.assignedEmail == '')
            && (!('assignedDivision' in data) || data.assignedDivision == '')
          )
        )
        && (!('repeatFreq' in data) || (
          data.repeatFreq is string
          && data.repeatFreq in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        ))
        && (!('repeatInterval' in data) || (
          data.repeatInterval is int
          && data.repeatInterval >= 1
          && data.repeatInterval <= 12
        ))
        && (!('repeatUntil' in data) || (
          data.repeatUntil is string
          && (data.repeatUntil == '' || (data.repeatUntil.size() == 10 && data.repeatUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        ))
        && (!('repeatWeekdays' in data) || (
          data.repeatWeekdays is list
          && data.repeatWeekdays.size() <= 7
          && (data.repeatWeekdays.size() == 0 || data.repeatWeekdays.hasOnly([0, 1, 2, 3, 4, 5, 6]))
        ))
        && (!('excludedDates' in data) || (
          data.excludedDates is list
          && data.excludedDates.size() <= 200
          && (data.excludedDates.size() == 0 || (
            data.excludedDates[0] is string
            && data.excludedDates[0].size() == 10
            && data.excludedDates[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          ))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdByEmail is string && data.createdByEmail.size() >= 5 && data.createdByEmail.size() <= 120
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }

    function canAccountViewCalendarEvent(acc, data) {
      let picUpper = accountPicFromData(acc);
      return acc.active == true && (
        acc.role == 'admin'
        || (
          picUpper != ''
          && 'assignedPicUpper' in data
          && data.assignedPicUpper is string
          && data.assignedPicUpper == picUpper
        )
        || (
          'assignedEmail' in data
          && data.assignedEmail is string
          && data.assignedEmail != ''
          && data.assignedEmail == request.auth.token.email.lower()
        )
        || (
          'assignedDivision' in data
          && data.assignedDivision is string
          && data.assignedDivision != ''
          && data.assignedDivision == acc.role
        )
      );
    }

    function canViewCalendarEvent(data) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        exists(path) && canAccountViewCalendarEvent(get(path).data, data)
      );
    }

    function canAccountListCalendarEvent(acc, data) {
      let picUpper = accountPicFromData(acc);
      return acc.active == true && (
        acc.role == 'admin'
        || (picUpper != '' && data.assignedPicUpper == picUpper)
        || data.assignedEmail == request.auth.token.email.lower()
        || (isOperationalRole(acc.role) && data.assignedDivision == acc.role)
      );
    }

    function canListCalendarEvent(data) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        exists(path) && canAccountListCalendarEvent(get(path).data, data)
      );
    }

    function isAccountAssignedPic(acc, data) {
      let picUpper = accountPicFromData(acc);
      return acc.active == true
        && 'eventType' in data && data.eventType == 'assign'
        && (!('assignScope' in data) || data.assignScope != 'division')
        && (
          (picUpper != '' && 'assignedPicUpper' in data && data.assignedPicUpper == picUpper)
          || ('assignedEmail' in data && data.assignedEmail != ''
            && data.assignedEmail == request.auth.token.email.lower())
        );
    }

    function isAccountDivisionMember(acc, data) {
      return acc.active == true
        && 'eventType' in data && data.eventType == 'assign'
        && 'assignScope' in data && data.assignScope == 'division'
        && 'assignedDivision' in data && data.assignedDivision == acc.role;
    }

    function canAccountUpdateCalendarEvent(acc, prevData, nextData) {
      let myPic = accountPicFromData(acc);
      return acc.active == true && (
        // Tier 1 (Admin): full management of calendar assignments
        (
          acc.role == 'admin'
          && nextData.diff(prevData).affectedKeys().hasOnly([
            'title', 'date', 'startTime', 'visibleTo', 'notes',
            'eventType', 'assignScope', 'assignedDivision',
            'assignedPic', 'assignedPicUpper', 'assignedEmail',
            'assignedRole', 'assignedOutlet', 'assignStatus', 'returnTime',
            'cancelReason', 'notificationDismissed', 'dismissedBy', 'picResponses',
            'repeatFreq', 'repeatInterval', 'repeatUntil', 'repeatWeekdays', 'excludedDates',
            'updatedAt', 'updatedBy'
          ])
        )
        // Tier 2a (PIC Assign User): explicitly dismiss persistent notification
        || (
          isAccountAssignedPic(acc, prevData)
          && nextData.notificationDismissed == true
          && nextData.diff(prevData).affectedKeys().hasOnly([
            'notificationDismissed', 'dismissedBy', 'updatedAt', 'updatedBy'
          ])
          && (!('dismissedBy' in nextData.diff(prevData).affectedKeys()) || isValidDismissedByAppend(prevData, nextData))
        )
        // Tier 2b (PIC Assign User): submit return time or cancel visit (not terminal yet)
        || (
          isAccountAssignedPic(acc, prevData)
          && prevData.assignStatus != 'cancelled'
          && nextData.assignStatus in ['assigned', 'completed', 'cancelled']
          && nextData.diff(prevData).affectedKeys().hasOnly([
            'assignStatus', 'returnTime', 'cancelReason', 'notificationDismissed', 'dismissedBy',
            'updatedAt', 'updatedBy'
          ])
          && (!('dismissedBy' in nextData.diff(prevData).affectedKeys()) || isValidDismissedByAppend(prevData, nextData))
        )
        // Tier 3a (Division Assign Member): dismiss persistent notification for self only
        || (
          isAccountDivisionMember(acc, prevData)
          && nextData.diff(prevData).affectedKeys().hasOnly([
            'dismissedBy', 'updatedAt', 'updatedBy'
          ])
          && isValidDismissedByAppend(prevData, nextData)
        )
        // Tier 3b (Division Assign Member): submit own return time or cancel own visit
        || (
          isAccountDivisionMember(acc, prevData)
          && prevData.assignStatus != 'cancelled'
          && myPic != ''
          && nextData.diff(prevData).affectedKeys().hasOnly([
            'picResponses', 'dismissedBy', 'updatedAt', 'updatedBy'
          ])
          && 'picResponses' in nextData
          && nextData.picResponses is map
          && nextData.picResponses.size() <= 60
          && myPic in nextData.picResponses
          && isValidPicResponseEntry(nextData.picResponses[myPic])
          && (
            ('picResponses' in prevData && prevData.picResponses is map)
              ? (
                nextData.picResponses.diff(prevData.picResponses).affectedKeys().hasOnly([myPic])
                && (!(myPic in prevData.picResponses) || prevData.picResponses[myPic].status != 'cancelled')
              )
              : nextData.picResponses.keys().hasOnly([myPic])
          )
          && (!('dismissedBy' in nextData.diff(prevData).affectedKeys()) || isValidDismissedByAppend(prevData, nextData))
        )
      );
    }

    match /calendarEvents/{eventId} {
      allow get: if isVerifiedUser() && isValidId(eventId) && canViewCalendarEvent(existing());
      allow list: if isVerifiedUser() && canListCalendarEvent(resource.data);
      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && isAdmin()
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdByEmail == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdByName == existing().createdByName
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          isBootstrappedAdmin()
          || (
            exists(accountDocPath())
            && canAccountUpdateCalendarEvent(get(accountDocPath()).data, existing(), incoming())
          )
        );
      allow delete: if isVerifiedUser() && isValidId(eventId) && isAdmin();
    }

    function isValidPersonalReminder(data) {
      return data.keys().hasAll([
          'title', 'date', 'startTime', 'notes',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && data.keys().hasOnly([
          'title', 'date', 'startTime', 'notes',
          'repeatFreq', 'repeatInterval', 'repeatUntil', 'repeatWeekdays', 'excludedDates',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidCalendarStartTime(data.startTime)
        && data.notes is string && data.notes.size() <= 500
        && (!('repeatFreq' in data) || (
          data.repeatFreq is string
          && data.repeatFreq in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        ))
        && (!('repeatInterval' in data) || (
          data.repeatInterval is int
          && data.repeatInterval >= 1
          && data.repeatInterval <= 12
        ))
        && (!('repeatUntil' in data) || (
          data.repeatUntil is string
          && (data.repeatUntil == '' || (data.repeatUntil.size() == 10 && data.repeatUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        ))
        && (!('repeatWeekdays' in data) || (
          data.repeatWeekdays is list
          && data.repeatWeekdays.size() <= 7
          && (data.repeatWeekdays.size() == 0 || data.repeatWeekdays.hasOnly([0, 1, 2, 3, 4, 5, 6]))
        ))
        && (!('excludedDates' in data) || (
          data.excludedDates is list
          && data.excludedDates.size() <= 200
          && (data.excludedDates.size() == 0 || (
            data.excludedDates[0] is string
            && data.excludedDates[0].size() == 10
            && data.excludedDates[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          ))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdByEmail is string && data.createdByEmail.size() >= 5 && data.createdByEmail.size() <= 120
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }

    match /personalReminders/{reminderId} {
      allow get: if isVerifiedUser()
        && isValidId(reminderId)
        && hasActiveAccount()
        && existing().createdBy == request.auth.uid;
      allow list: if isVerifiedUser()
        && hasActiveAccount()
        && resource.data.createdBy == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(reminderId)
        && isValidPersonalReminder(incoming())
        && hasActiveAccount()
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdByEmail == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(reminderId)
        && isValidPersonalReminder(incoming())
        && hasActiveAccount()
        && existing().createdBy == request.auth.uid
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdByName == existing().createdByName
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'date', 'startTime', 'notes',
          'repeatFreq', 'repeatInterval', 'repeatUntil', 'repeatWeekdays', 'excludedDates',
          'updatedAt', 'updatedBy'
        ]);
      allow delete: if isVerifiedUser()
        && isValidId(reminderId)
        && hasActiveAccount()
        && existing().createdBy == request.auth.uid;
    }

    function isValidCounterId(id) {
      return id is string && id.size() == 7 && id.matches('^(SA|GL)_[0-9]{4}$');
    }

    function isValidRecordCounter(data) {
      return data.keys().hasAll(['prefix', 'yymm', 'seq', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['prefix', 'yymm', 'seq', 'updatedAt', 'updatedBy'])
        && data.prefix is string && data.prefix in ['SA', 'GL']
        && data.yymm is string && data.yymm.size() == 4 && data.yymm.matches('^[0-9]{4}$')
        && data.seq is int && data.seq >= 1 && data.seq <= 999999
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function canAccountGetCounter(acc, counterId) {
      return acc.active == true && (
        acc.role in ['admin', 'accounting']
        || (acc.role == 'stock_accounting' && counterId.matches('^SA_[0-9]{4}$'))
        || (acc.role == 'gl' && counterId.matches('^GL_[0-9]{4}$'))
      );
    }

    function canGetRecordCounter(counterId) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        exists(path) && canAccountGetCounter(get(path).data, counterId)
      );
    }

    match /recordCounters/{counterId} {
      allow get: if isVerifiedUser() && isValidCounterId(counterId) && canGetRecordCounter(counterId);
      allow list: if false;
      allow delete: if isVerifiedUser() && isValidCounterId(counterId) && isAdmin();
      allow create: if isVerifiedUser()
        && isValidCounterId(counterId)
        && isValidRecordCounter(incoming())
        && counterId == (incoming().prefix + '_' + incoming().yymm)
        && incoming().seq == 1
        && isAuthorizedRecordPrefix(incoming().prefix)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidCounterId(counterId)
        && isValidRecordCounter(incoming())
        && incoming().prefix == existing().prefix
        && incoming().yymm == existing().yymm
        && counterId == (existing().prefix + '_' + existing().yymm)
        && incoming().seq == existing().seq + 1
        && isAuthorizedRecordPrefix(incoming().prefix)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
    }

    function isValidRecordId(id) {
      return id is string && id.size() >= 10 && id.size() <= 16 && id.matches('^(SA|GL)[0-9]{8,}$');
    }

    function isValidSavedRecord(data) {
      return data.keys().hasAll([
          'refCode', 'prefix', 'yymm', 'department', 'date', 'pic', 'outlet',
          'summary', 'notes', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && data.keys().hasOnly([
          'refCode', 'prefix', 'yymm', 'department', 'date', 'pic', 'outlet',
          'summary', 'notes', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'createdByEmail', 'createdByName'
        ])
        && isValidRecordId(data.refCode)
        && data.prefix is string && data.prefix in ['SA', 'GL']
        && data.yymm is string && data.yymm.size() == 4 && data.yymm.matches('^[0-9]{4}$')
        && data.department is string
        && ((data.prefix == 'SA' && data.department == 'stock_accounting')
            || (data.prefix == 'GL' && data.department == 'gl'))
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.pic is string && data.pic.size() >= 1 && data.pic.size() <= 60
        && data.outlet is string && data.outlet.size() >= 1 && data.outlet.size() <= 40
        && data.summary is string && data.summary.size() <= 200
        && data.notes is string && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdByEmail is string && data.createdByEmail.size() >= 5 && data.createdByEmail.size() <= 120
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }

    function canAccountViewSavedRecord(acc, data) {
      return acc.active == true && (
        acc.role in ['admin', 'accounting']
        || (acc.role in ['stock_accounting', 'gl'] && data.department == acc.role)
      );
    }

    function canViewSavedRecord(data) {
      let path = accountDocPath();
      return isBootstrappedAdmin() || (
        exists(path) && canAccountViewSavedRecord(get(path).data, data)
      );
    }

    match /savedRecords/{recordId} {
      allow get: if isVerifiedUser() && isValidRecordId(recordId) && canViewSavedRecord(existing());
      allow list: if isVerifiedUser() && canViewSavedRecord(resource.data);
      allow create: if isVerifiedUser()
        && isValidRecordId(recordId)
        && isValidSavedRecord(incoming())
        && recordId == incoming().refCode
        && incoming().yymm == (incoming().date[2:4] + incoming().date[5:7])
        && incoming().refCode[0:2] == incoming().prefix
        && incoming().refCode[2:6] == incoming().yymm
        && canCreateSavedRecordAuth(incoming().prefix, incoming().department, incoming().pic, incoming().outlet)
        && existsAfter(/databases/$(database)/documents/recordCounters/$(incoming().prefix + '_' + incoming().yymm))
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdByEmail == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidRecordId(recordId)
        && isValidSavedRecord(incoming())
        && canUpdateSavedRecordAuth(existing().createdBy, existing().prefix, existing().department, incoming().pic, incoming().outlet)
        && incoming().refCode == existing().refCode
        && incoming().prefix == existing().prefix
        && incoming().yymm == existing().yymm
        && incoming().department == existing().department
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdByName == existing().createdByName
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'pic', 'outlet', 'summary', 'notes', 'updatedAt', 'updatedBy']);
      allow delete: if isVerifiedUser() && isValidRecordId(recordId) && isAccountingOrAdmin();
    }

    function isValidCalendarMedia(data) {
      return data.keys().hasAll([
          'imageDataUrl', 'caption', 'fileName', 'updatedAt', 'updatedBy', 'updatedByName'
        ])
        && data.keys().hasOnly([
          'imageDataUrl', 'caption', 'fileName', 'sortOrder', 'updatedAt', 'updatedBy', 'updatedByName'
        ])
        && data.imageDataUrl is string
        && data.imageDataUrl.size() >= 22
        && data.imageDataUrl.size() <= 750000
        && data.imageDataUrl[0:32].matches('^data:image/(png|jpeg|jpg|webp|gif);base64,.*')
        && data.caption is string && data.caption.size() <= 200
        && data.fileName is string && data.fileName.size() <= 120
        && (!('sortOrder' in data) || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100000))
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80;
    }

    match /calendarMedia/{mediaId} {
      allow get: if isVerifiedUser() && isValidId(mediaId) && hasActiveAccount();
      allow list: if isVerifiedUser() && hasActiveAccount();
      allow create: if isVerifiedUser()
        && isValidId(mediaId)
        && isValidCalendarMedia(incoming())
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(mediaId)
        && isValidCalendarMedia(incoming())
        && isAdmin()
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl', 'caption', 'fileName', 'sortOrder', 'updatedAt', 'updatedBy', 'updatedByName'
        ]);
      allow delete: if isVerifiedUser() && isValidId(mediaId) && isAdmin();
    }
  }
}
