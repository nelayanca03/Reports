{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "User account profile and role assignment managed by Admin",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "Lowercase Google account email address"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "stock_accounting", "gl", "accounting"],
          "description": "Assigned RBAC role"
        },
        "picName": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional default PIC identifier assigned to this account"
        },
        "refPrefix": {
          "type": "string",
          "enum": ["SA", "GL"],
          "description": "Optional department reference prefix authorization for accounting accounts"
        },
        "active": {
          "type": "boolean",
          "description": "Whether this account is allowed to access the application"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of admin who created this account"
        }
      },
      "required": ["email", "name", "role", "picName", "active", "createdAt", "updatedAt", "createdBy"]
    },
    "AdminAccountDirectory": {
      "title": "AdminAccountDirectory",
      "description": "Admin-only directory index of all registered accounts",
      "type": "object",
      "properties": {
        "accounts": {
          "type": "object",
          "description": "Map of accountId to account summary"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of admin who updated the directory"
        }
      },
      "required": ["accounts", "updatedAt", "updatedBy"]
    },
    "AdminResetSecurity": {
      "title": "AdminResetSecurity",
      "description": "Admin-only salted PBKDF2-SHA256 password hash protecting full user-data resets",
      "type": "object",
      "properties": {
        "passwordHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64,
          "description": "Hex-encoded PBKDF2-SHA256 derived password hash"
        },
        "salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32,
          "description": "Hex-encoded 128-bit random salt"
        },
        "iterations": {
          "type": "integer",
          "description": "PBKDF2 iteration count (100000)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last password update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of admin who set or updated the reset password"
        }
      },
      "required": ["passwordHash", "salt", "iterations", "updatedAt", "updatedBy"]
    },
    "RoleConfig": {
      "title": "RoleConfig",
      "description": "Tasks and outlet assignments configured by Admin for an operational role",
      "type": "object",
      "properties": {
        "roleId": {
          "type": "string",
          "enum": ["stock_accounting", "gl", "accounting"],
          "description": "Operational role identifier"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Human-readable role title"
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Start date of working period (YYYY-MM-DD)"
        },
        "ndays": {
          "type": "integer",
          "description": "Number of working days in period"
        },
        "openUntilMonth": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 7,
          "description": "Optional Admin-configured furthest accessible calendar month (YYYY-MM)"
        },
        "unlockedPastMonths": {
          "type": "array",
          "description": "Bounded list of past YYYY-MM months explicitly reopened for non-admin users by Admin"
        },
        "tasks": {
          "type": "array",
          "description": "List of tasks assigned to this role"
        },
        "outlets": {
          "type": "array",
          "description": "List of outlets and PIC mappings assigned to this role"
        },
        "outletsByPic": {
          "type": "object",
          "description": "Map of uppercase PIC name to list of assigned outlet codes for rule enforcement"
        },
        "dayAdjustments": {
          "type": "array",
          "description": "Bounded list of working-day adjustments (off_day, cuti_izin, cuti_bersama, libur_nasional) scoped by person, role, or all"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last config update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of admin who updated this config"
        }
      },
      "required": ["roleId", "label", "start", "ndays", "tasks", "outlets", "updatedAt", "updatedBy"]
    },
    "RoleWorkspace": {
      "title": "RoleWorkspace",
      "description": "Legacy daily update entries and outlet visit logs for an operational role",
      "type": "object",
      "properties": {
        "roleId": {
          "type": "string",
          "enum": ["stock_accounting", "gl", "accounting"],
          "description": "Operational role identifier"
        },
        "ent": {
          "type": "object",
          "description": "Nested map of outlet -> (day|task) -> { d, n, ts, byAdmin? }"
        },
        "visit": {
          "type": "object",
          "description": "Map of (person|day) -> { ok, outlet?, f, t, n, entries?: [{ id, outlet, f, t, n }] }"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last workspace update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of user who performed the last write"
        }
      },
      "required": ["roleId", "ent", "visit", "updatedAt", "updatedBy"]
    },
    "RoleMonthlyWorkspace": {
      "title": "RoleMonthlyWorkspace",
      "description": "Monthly partitioned daily update entries and outlet visit logs for an operational role",
      "type": "object",
      "properties": {
        "roleId": {
          "type": "string",
          "enum": ["stock_accounting", "gl", "accounting"],
          "description": "Operational role identifier"
        },
        "monthKey": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 7,
          "description": "Calendar month key in YYYY-MM format"
        },
        "ent": {
          "type": "object",
          "description": "Nested map of outlet -> (day|task) -> { d, n, ts, byAdmin? }"
        },
        "visit": {
          "type": "object",
          "description": "Map of (person|day) -> { ok, outlet?, f, t, n, entries?: [{ id, outlet, f, t, n }] }"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last monthly workspace update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of user who performed the last write"
        }
      },
      "required": ["roleId", "monthKey", "ent", "visit", "updatedAt", "updatedBy"]
    },
    "InputLog": {
      "title": "InputLog",
      "description": "Immutable audit log entry recorded whenever a user saves daily updates or visits",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the user who performed the input"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "Lowercase email of the user"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the user"
        },
        "userRole": {
          "type": "string",
          "enum": ["admin", "stock_accounting", "gl", "accounting"],
          "description": "Account role of the user"
        },
        "roleId": {
          "type": "string",
          "enum": ["stock_accounting", "gl", "accounting"],
          "description": "Target operational workspace role ID"
        },
        "roleLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Human-readable workspace role label"
        },
        "actionType": {
          "type": "string",
          "enum": ["input_harian", "kunjungan"],
          "description": "Whether this log is from Input Harian or Kunjungan"
        },
        "pic": {
          "type": "string",
          "maxLength": 60,
          "description": "PIC name associated with the entry"
        },
        "outlet": {
          "type": "string",
          "maxLength": 120,
          "description": "Outlet code(s) associated with the entry"
        },
        "day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Working date (YYYY-MM-DD)"
        },
        "details": {
          "type": "string",
          "maxLength": 600,
          "description": "Summary of saved items"
        },
        "itemCount": {
          "type": "integer",
          "description": "Number of task or visit items included in this save"
        },
        "clientTs": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Client ISO timestamp string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when log was written"
        },
        "taskKey": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional task key for per-item revision logs"
        },
        "prevDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Previous task update date or month value before edit"
        },
        "newDate": {
          "type": "string",
          "maxLength": 20,
          "description": "New task update date or month value after edit"
        },
        "prevNote": {
          "type": "string",
          "maxLength": 100,
          "description": "Previous task note before edit"
        },
        "newNote": {
          "type": "string",
          "maxLength": 100,
          "description": "New task note after edit"
        },
        "action": {
          "type": "string",
          "enum": ["set", "clear", "edit"],
          "description": "Item-level revision action"
        }
      },
      "required": [
        "uid",
        "userEmail",
        "userName",
        "userRole",
        "roleId",
        "roleLabel",
        "actionType",
        "pic",
        "outlet",
        "day",
        "details",
        "itemCount",
        "clientTs",
        "createdAt"
      ]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "PIC-assigned calendar task managed by Admin with automatic visit tracking and persistent notification",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Event or assignment title displayed on calendar grid"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Event date in YYYY-MM-DD format"
        },
        "startTime": {
          "type": "string",
          "pattern": "^(0[89]|1[0-8]):(00|30)|19:00$",
          "maxLength": 5,
          "description": "Starting time between 08:00 and 19:00 in 30-minute intervals"
        },
        "visibleTo": {
          "type": "array",
          "description": "Operational role metadata associated with this event"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional notes and instructions"
        },
        "eventType": {
          "type": "string",
          "enum": ["assign", "general"],
          "description": "Whether this is a PIC/Division assignment or legacy general event"
        },
        "assignScope": {
          "type": "string",
          "enum": ["pic", "division"],
          "description": "Whether the assignment targets a single PIC or an entire division"
        },
        "assignedDivision": {
          "type": "string",
          "maxLength": 32,
          "description": "Operational role/division targeted when assignScope is division (empty string for PIC assigns)"
        },
        "assignedPic": {
          "type": "string",
          "maxLength": 60,
          "description": "Display name of the specific PIC assigned to this calendar entry"
        },
        "assignedPicUpper": {
          "type": "string",
          "maxLength": 60,
          "description": "Uppercase trimmed PIC name used for strict PIC-only Firestore queries and rules"
        },
        "assignedEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional lowercase email of the assigned user account"
        },
        "assignedRole": {
          "type": "string",
          "enum": ["stock_accounting", "gl", "accounting"],
          "description": "Operational role/division of the assigned PIC or division for visit synchronization"
        },
        "assignedOutlet": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional target outlet code for this assignment"
        },
        "assignStatus": {
          "type": "string",
          "enum": ["assigned", "completed", "cancelled"],
          "description": "Execution status of the assignment (assigned=+1 visit, completed=+1 with returnTime, cancelled=0 visit)"
        },
        "returnTime": {
          "type": "string",
          "maxLength": 5,
          "description": "Optional HH:MM return time reported by the assigned user upon completion"
        },
        "cancelReason": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional reason when the user cancels / does not attend the assignment"
        },
        "notificationDismissed": {
          "type": "boolean",
          "description": "Whether the assigned PIC has explicitly closed the persistent top notification popup"
        },
        "dismissedBy": {
          "type": "array",
          "description": "List of UIDs who have explicitly dismissed the persistent notification popup for this assignment"
        },
        "picResponses": {
          "type": "object",
          "description": "Map of uppercase PIC name to { status, returnTime, cancelReason } for division-wide assignments"
        },
        "repeatFreq": {
          "type": "string",
          "enum": ["none", "daily", "weekly", "monthly", "yearly"],
          "description": "Recurrence frequency of the calendar event"
        },
        "repeatInterval": {
          "type": "integer",
          "description": "Interval between recurrences (1 to 12)"
        },
        "repeatUntil": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Optional inclusive recurrence end date (YYYY-MM-DD) or empty string"
        },
        "repeatWeekdays": {
          "type": "array",
          "description": "Days of week (0-6) for weekly repeating events"
        },
        "excludedDates": {
          "type": "array",
          "description": "Specific YYYY-MM-DD occurrence dates skipped from the recurring series"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "title",
        "date",
        "startTime",
        "visibleTo",
        "notes",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy",
        "createdByEmail",
        "createdByName"
      ]
    },
    "PersonalReminder": {
      "title": "PersonalReminder",
      "description": "Private personal calendar reminder visible and editable strictly by its owner",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Personal reminder title"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Reminder date in YYYY-MM-DD format"
        },
        "startTime": {
          "type": "string",
          "pattern": "^(0[89]|1[0-8]):(00|30)|19:00$",
          "maxLength": 5,
          "description": "Reminder time slot between 08:00 and 19:00"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional personal notes"
        },
        "repeatFreq": {
          "type": "string",
          "enum": ["none", "daily", "weekly", "monthly", "yearly"]
        },
        "repeatInterval": {
          "type": "integer"
        },
        "repeatUntil": {
          "type": "string",
          "maxLength": 10
        },
        "repeatWeekdays": {
          "type": "array"
        },
        "excludedDates": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "title",
        "date",
        "startTime",
        "notes",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy",
        "createdByEmail",
        "createdByName"
      ]
    },
    "RecordCounter": {
      "title": "RecordCounter",
      "description": "Atomic per-department per-month sequence counter for reference code generation",
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "enum": ["SA", "GL"]
        },
        "yymm": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "maxLength": 4
        },
        "seq": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["prefix", "yymm", "seq", "updatedAt", "updatedBy"]
    },
    "SavedRecord": {
      "title": "SavedRecord",
      "description": "Saved outlet record with permanent automatic SA/GL reference code",
      "type": "object",
      "properties": {
        "refCode": {
          "type": "string",
          "pattern": "^(SA|GL)[0-9]{8,}$",
          "maxLength": 16
        },
        "prefix": {
          "type": "string",
          "enum": ["SA", "GL"]
        },
        "yymm": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "maxLength": 4
        },
        "department": {
          "type": "string",
          "enum": ["stock_accounting", "gl"]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "pic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "outlet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "refCode",
        "prefix",
        "yymm",
        "department",
        "date",
        "pic",
        "outlet",
        "summary",
        "notes",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy",
        "createdByEmail",
        "createdByName"
      ]
    },
    "CalendarMedia": {
      "title": "CalendarMedia",
      "description": "Admin-managed images displayed below the calendar, viewable read-only by all active users",
      "type": "object",
      "properties": {
        "imageDataUrl": {
          "type": "string",
          "minLength": 22,
          "maxLength": 750000,
          "description": "Compressed base64 image data URL (png/jpeg/webp/gif)"
        },
        "caption": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional short caption shown beneath the calendar image"
        },
        "fileName": {
          "type": "string",
          "maxLength": 120,
          "description": "Original uploaded image file name"
        },
        "sortOrder": {
          "type": "integer",
          "description": "Optional display order index for sorting multiple calendar images"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of admin who uploaded or replaced the image"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of admin who updated the image"
        }
      },
      "required": [
        "imageDataUrl",
        "caption",
        "fileName",
        "updatedAt",
        "updatedBy",
        "updatedByName"
      ]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Individual user account documents indexed by sanitized email ID"
    },
    "/adminRegistry/{registryId}": {
      "schema": { "$ref": "#/entities/AdminAccountDirectory" },
      "description": "Admin-only registry documents: accounts directory (accounts) and PBKDF2 reset password hash (resetSecurity)"
    },
    "/roleConfigs/{roleId}": {
      "schema": { "$ref": "#/entities/RoleConfig" },
      "description": "Task and outlet definitions per operational role (stock_accounting, gl, accounting)"
    },
    "/roleWorkspaces/{roleId}": {
      "schema": { "$ref": "#/entities/RoleWorkspace" },
      "description": "Legacy daily task entries and outlet visit logs per operational role"
    },
    "/roleMonthlyWorkspaces/{workspaceMonthId}": {
      "schema": { "$ref": "#/entities/RoleMonthlyWorkspace" },
      "description": "Monthly partitioned daily task entries and outlet visit logs indexed by roleId_YYYY-MM"
    },
    "/inputLogs/{logId}": {
      "schema": { "$ref": "#/entities/InputLog" },
      "description": "Immutable history logs of all user daily input and visit submissions, readable only by Admin"
    },
    "/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Admin-managed PIC calendar assignments visible strictly to Admin and the assigned PIC"
    },
    "/personalReminders/{reminderId}": {
      "schema": { "$ref": "#/entities/PersonalReminder" },
      "description": "Owner-only personal calendar reminders created by any active user"
    },
    "/recordCounters/{counterId}": {
      "schema": { "$ref": "#/entities/RecordCounter" },
      "description": "Atomic sequence counters indexed by SA_YYMM or GL_YYMM"
    },
    "/savedRecords/{recordId}": {
      "schema": { "$ref": "#/entities/SavedRecord" },
      "description": "Saved outlet records indexed by permanent SA/GL reference code"
    },
    "/calendarMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/CalendarMedia" },
      "description": "Admin-managed gallery images displayed below the calendar, read-only for all active users"
    }
  }
}
